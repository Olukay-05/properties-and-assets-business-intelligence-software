APP_NAME="Property & Asset Intelligence"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 17 + PostGIS (docker-compose service "postgres", port 5433 on the host)
#
# Three database roles, never one (docs/security/RLS-POLICIES.md §3):
#
#   pai         container superuser. Provisioning only; the app never uses it.
#   pai_owner   schema owner. Runs `php artisan migrate` (DB_MIGRATION_*),
#               owns every table and RLS policy, and has no BYPASSRLS.
#   pai_app     application runtime role (DB_*). NOSUPERUSER NOBYPASSRLS, owns
#               nothing, so FORCE ROW LEVEL SECURITY applies to every query.
#
# `pai_owner`, `pai_app` and `pai_bootstrap` are created on first boot by
# docker/postgres/init/01-create-roles.sh. The passwords below are local
# placeholders only; never reuse them outside a local machine (ENV.md).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=property_asset_intelligence
DB_USERNAME=pai_app
DB_PASSWORD=pai_app_local_only

# Schema owner, used only by `php artisan migrate`.
DB_MIGRATION_USERNAME=pai_owner
DB_MIGRATION_PASSWORD=pai_owner_local_only

# Optional: pin the runtime role name/password explicitly. Defaults to DB_*.
# DB_APP_USERNAME=pai_app
# DB_APP_PASSWORD=pai_app_local_only

# SSL mode for PostgreSQL (`prefer` locally; `require` or `verify-full` on Neon).
DB_SSLMODE=prefer

# Superuser for the local container only (docker-compose creates it on first
# boot). The application never connects with it.
POSTGRES_SUPERUSER=pai
POSTGRES_SUPERUSER_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible object storage, configured entirely by environment variables.
#
# The application uses Laravel's standard `s3` disk and never references a
# specific provider in code. Locally the endpoint is the RustFS service from
# docker-compose; in production it is a private Cloudflare R2 bucket. Switching
# providers means changing these values only.
#
# Evidence buckets are always private: objects are never publicly readable and
# are served only through short-lived pre-signed URLs.
AWS_ACCESS_KEY_ID=pai-local
AWS_SECRET_ACCESS_KEY=pai-local-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=property-asset-intelligence
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_URL=

# Pre-signed URL lifetime for evidence downloads, in minutes.
EVIDENCE_SIGNED_URL_TTL_MINUTES=10

VITE_APP_NAME="${APP_NAME}"
