APP_NAME="Property & Asset Intelligence"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 17 + PostGIS (docker-compose service "postgres", port 5433 on the host)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=property_asset_intelligence
DB_USERNAME=pai
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible object storage, configured entirely by environment variables.
#
# The application uses Laravel's standard `s3` disk and never references a
# specific provider in code. Locally the endpoint is the RustFS service from
# docker-compose; in production it is a private Cloudflare R2 bucket. Switching
# providers means changing these values only.
#
# Evidence buckets are always private: objects are never publicly readable and
# are served only through short-lived pre-signed URLs.
AWS_ACCESS_KEY_ID=pai-local
AWS_SECRET_ACCESS_KEY=pai-local-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=property-asset-intelligence
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_URL=

# Pre-signed URL lifetime for evidence downloads, in minutes.
EVIDENCE_SIGNED_URL_TTL_MINUTES=10

VITE_APP_NAME="${APP_NAME}"
