# Generated from PHP Data classes by `php artisan types:transform`. Build
# artifact: regenerate rather than commit, so the PHP classes stay the single
# source of truth for the PHP <-> TypeScript contract.
/resources/js/types/generated/*
!/resources/js/types/generated/.gitkeep

# Local tooling and scratch work
/.scratch
/.acl-recovery
/.pnpm-store
/tools/phpshim

# Agent tooling installed locally by the starter kit and the AI harness. The
# canonical BMAD skills live in _bmad; these directories are per-tool mirrors
# that would otherwise flood the repository with thousands of duplicated files.
#
# Listed explicitly (both singular and plural spellings) rather than relying on
# a parent-directory rule, so the intent survives reorganising these folders.
/.agent/skill
/.agent/skills
/.agents/skill
/.agents/skills
/.qoder
/.qwen
/.opencode

# Starter-kit installer scripts, consumed at scaffold time and no longer used.
/chisel.php
/chisel-paths.php
